# Dependencies and package manager caches (keep lockfiles in Git)
node_modules/
.npm/
.pnpm-store/

# Standalone local tooling repository (not a project submodule)
/superpowers/

# Local environment and credentials (keep example files in Git)
.env
.env.*
config.env
config.env.*
!.env.example
!.env.*.example
!config.env.example
!config.env.*.example

# Frontend and backend build output, including the legacy backend
/frontend/build/
/frontend/dist/
/backend/dist/
/ServerSide/dist/
*.tsbuildinfo
.vite/
.cache/
.eslintcache
.stylelintcache

# Test coverage and generated test reports
coverage/
.nyc_output/
playwright-report/
test-results/
/frontend-lifecycle-*-results.json
/backend/realistic-test-verification.json

# Runtime logs and diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.*.json

# Local temporary files and database backups (keep SQL migrations in Git)
/.tmp/
/.docker-recovery/
/pgsms-full-backup-*/
/pgsms-full-backup-*.zip
*.dump
*.dmp

# User-uploaded documents and photos
/backend/public/submissions/submitted/*
!/backend/public/submissions/submitted/.gitkeep
/backend/public/img/users/user-*
/public/submissions/submitted/*
!/public/submissions/submitted/.gitkeep
/public/img/users/user-*

# Python research environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Research model weights (keep reports, metrics and experiment configs in Git)
/KET_QUA_*/**/*.ckpt
/KET_QUA_*/**/*.pt
/KET_QUA_*/**/*.pth
/KET_QUA_*/**/*.onnx

# OS metadata and editor temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Local transcript implementation diary and retired comparison fonts
/TRANSCRIPT-EXPORT-CONTINUOUS-IMPLEMENTATION.md
/frontend/public/fonts/transcript/NotoSerif-*.ttf
/frontend/public/fonts/transcript/OFL.txt
