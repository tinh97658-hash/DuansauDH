# Dependencies and generated builds (keep package manifests and lockfiles)
node_modules/
node_modules-before-*/
dist/
build/
coverage/
*.tsbuildinfo
.pnp.*

# Local credentials; commit only explicitly named configuration templates
.env
.env.*
!.env.example
!.env.*.example
config.env
config.env.*
!config.env.example
*.key
*.p12
*.pfx

# Tool caches and disposable test/browser output
.cache/
.vite/
.nyc_output/
.eslintcache
.stylelintcache
test-results/
playwright-report/
blob-report/
*.lcov
*.tmp
*.tmp.*
*.temp

# Machine-specific editor settings; shared tasks/launch/extensions can be committed
/.vscode/*
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

# Local diagnostics, database backups and generated verification reports
/.local/
/.tmp/
/.docker-recovery/
*.log
*.dump
*.dmp
*.bak
/backups/
/pgsms-full-backup-*/
/pgsms-full-backup-*.zip
/frontend-*-results.json
/backend/realistic-test-verification.json
/docs/data-changes/
/docs/imports/*-before-*.json
/backend/.tmp-*
/route-endpoints.txt

# Runtime user uploads, never source assets
/backend/public/userDocs/
/backend/public/submissions/submitted/
/backend/public/img/users/

# Generated audit/test snapshots; keep Markdown reports and verification scripts
/security-review/*.json

# Local transcript implementation diary and retired comparison fonts
/TRANSCRIPT-EXPORT-CONTINUOUS-IMPLEMENTATION.md
/frontend/public/fonts/transcript/NotoSerif-*.ttf
/frontend/public/fonts/transcript/OFL.txt

# Local audit workspaces, disposable databases and browser verification artifacts
/.audit-db0f26c/
/.ui-verification/
/.next-verification/
/.rollback-verification/
/.dashboard-verification/
/.antigravity-qa/
