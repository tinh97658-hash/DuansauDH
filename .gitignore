# Dependencies and generated builds (keep package manifests and lockfiles)
node_modules/
node_modules-before-*/
dist/
build/
coverage/
*.tsbuildinfo
.pnp.*

# Local credentials; commit only explicitly named configuration templates
.env
.env.*
!.env.example
!.env.*.example
config.env
config.env.*
!config.env.example
*.key
*.p12
*.pfx

# Private key filenames; retain public keys and public CA certificates
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.private.pem
*-private.pem
*_private.pem
*_key.pem

# Tool caches and disposable test/browser output
.cache/
.vite/
.nyc_output/
.eslintcache
.stylelintcache
test-results/
playwright-report/
blob-report/
*.lcov
*.tmp
*.tmp.*
*.temp

# Machine-specific editor settings; shared tasks/launch/extensions can be committed
/.vscode/*
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

