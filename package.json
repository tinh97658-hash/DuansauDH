{
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "start:dev": "npm run dev",
    "start:prod": "npm --prefix backend run start:prod",
    "preview": "npm --prefix frontend run preview",
    "typecheck": "npm --prefix backend run typecheck",
    "db:migrate": "npm --prefix backend run db:migrate --",
    "db:migrate:undo": "npm --prefix backend run db:migrate:undo --",
    "db:migrate:status": "npm --prefix backend run db:migrate:status --",
    "db:seed:admin": "npm --prefix backend run db:seed:admin --",
    "db:seed:auth": "npm --prefix backend run db:seed:auth --",
    "db:seed:common": "npm --prefix backend run db:seed:common --",
    "db:seed:demo": "npm --prefix backend run db:seed:demo --",
    "db:seed:scheduling-test": "npm --prefix backend run db:seed:scheduling-test --",
    "db:seed:exam-demo": "npm --prefix backend run db:seed:exam-demo --",
    "db:seed:masters": "npm --prefix backend run db:seed:masters --",
    "db:seed:admissions": "npm --prefix backend run db:seed:admissions --",
    "db:seed:lecturers": "npm --prefix backend run db:seed:lecturers --",
    "db:seed:bulk": "npm --prefix backend run db:seed:bulk --",
    "db:seed:bulk:preview": "npm --prefix backend run db:seed:bulk:preview --",
    "db:test:bulk": "npm --prefix backend run db:test:bulk --",
    "db:seed:realistic-test": "npm --prefix backend run db:seed:realistic-test --",
    "db:seed:realistic-test:preview": "npm --prefix backend run db:seed:realistic-test:preview --",
    "db:seed:vmu": "npm --prefix backend run db:seed:vmu --",
    "test:scripts": "node --test scripts/dev.test.cjs",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix backend run test:ci",
    "test:frontend": "npm --prefix frontend run test:ci",
    "test:coverage": "npm --prefix backend run test:coverage && npm --prefix frontend run test:coverage"
  },
  "dependencies": {
    "react-router-dom": "^7.18.4"
  }
}
