{
  "name": "serverside",
  "version": "1.0.0",
  "description": "This is the server side of the PostGraduate Student Management system",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest.config.cjs --runInBand",
    "test:unit": "npm test -- test/unit",
    "test:integration": "npm test -- test/integration",
    "test:e2e": "npm test -- test/e2e",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest.config.cjs --watch",
    "test:coverage": "npm test -- --coverage",
    "test:ci": "npm test -- --ci --coverage",
    "db:migrate": "npm run build && node dist/database/migrate.js up",
    "db:migrate:undo": "npm run build && node dist/database/migrate.js down",
    "db:migrate:status": "npm run build && node dist/database/migrate.js status",
    "db:seed:admin": "npm run build && node dist/database/seed-admin.js",
    "db:seed:common": "npm run build && node dist/database/seed-common.js",
    "db:seed:demo": "npm run build && node dist/database/seed-demo.js"
  },
  "author": "Jeewantha Udeshika Ariyawansha",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^11.2.2",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.2",
    "@nestjs/sequelize": "^11.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.7.4",
    "connect-session-sequelize": "^8.0.6",
    "cookie-parser": "^1.4.7",
    "express-flash": "^0.0.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.6",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth2": "^0.2.0",
    "passport-local": "^1.0.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
