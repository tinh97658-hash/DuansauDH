# Copy to .env at the repository root. Fill all required secrets before starting.
NODE_ENV=development
WEB_PORT=3100
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=55432
DB_ADMIN_PORT=5051
POSTGRES_DB=pgsms
POSTGRES_USER=pgsms
POSTGRES_PASSWORD=
PGADMIN_EMAIL=admin@example.invalid
PGADMIN_PASSWORD=
# Generate at least 32 random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
TRUST_PROXY=0
DATABASE_SSL=false
# Optional PEM CA for a PostgreSQL server using a private certificate authority.
DATABASE_SSL_CA=
FRONTEND_URL=http://localhost:${WEB_PORT}
API_PUBLIC_URL=http://localhost:${PORT}
REACT_APP_API_URL=${API_PUBLIC_URL}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional initial administrator; set before running db:seed:admin.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional SMTP transport for password recovery emails.
HOST=
HOSTPORT=587
SERVICE=
EMAIL_USERNAME=
PASSWORD=
