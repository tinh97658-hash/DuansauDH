# Copy to .env and fill in real values. Never commit .env.
# The backend validates these variables at startup (see backend/src/config/configuration.ts).

NODE_ENV=development

# --- HTTP ---
PORT=3001
WEB_PORT=3100
API_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3100
TRUST_PROXY=0

# --- PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=55432
POSTGRES_DB=pgsms
POSTGRES_USER=pgsms
POSTGRES_PASSWORD=change-me
# Optional: overrides the URL assembled from the variables above.
# DATABASE_URL=postgres://pgsms:change-me@127.0.0.1:55432/pgsms
DATABASE_SSL=false
DB_POOL_MAX=25
DB_POOL_MIN=2

# --- Session / auth ---
# Must be at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Initial administrator created by `npm run db:seed:admin`.
ADMIN_NAME=Quản trị viên
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- pgAdmin (docker compose) ---
DB_ADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# --- Face recognition service ---
FACE_SERVICE_URL=http://localhost:8000
FACE_SERVICE_API_KEY=change-me
FACE_SERVICE_TIMEOUT_MS=15000
# Reject an enrollment when it matches another learner above this cosine score.
# Set to 0 to disable the duplicate check.
FACE_ENROLLMENT_DUPLICATE_THRESHOLD=0.6
ATTENDANCE_AMBIGUITY_SCORE=0.45
ATTENDANCE_AMBIGUITY_MARGIN=0.15

# --- Mail (optional; skipped when EMAIL_USERNAME is empty) ---
EMAIL_USERNAME=
PASSWORD=

# --- Frontend build/dev server ---
REACT_APP_API_URL=http://localhost:3001
