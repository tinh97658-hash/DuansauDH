WEB_PORT=3100
DB_PORT=55432
POSTGRES_DB=pgsms
POSTGRES_USER=pgsms
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://pgsms:replace-with-a-long-random-password@127.0.0.1:55432/pgsms
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
DATABASE_SSL=false
FRONTEND_URL=http://localhost:3100
API_PUBLIC_URL=http://localhost:3100/api
DB_ADMIN_PORT=5051
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=replace-with-a-strong-pgadmin-password

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HOST=
HOSTPORT=
SERVICE=
EMAIL_USERNAME=
PASSWORD=

# Bootstrap administrator (used by npm run db:seed:admin)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
