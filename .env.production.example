# Copy to .env.production. This file is a template; never commit real secrets.
APP_ENV_FILE=.env.production
NODE_ENV=production
WEB_PORT=8080
PORT=3001
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=pgsms
POSTGRES_USER=pgsms
POSTGRES_PASSWORD=
SESSION_SECRET=
SESSION_COOKIE_SECURE=true
# Two proxies: host HTTPS ingress -> container Nginx -> API.
TRUST_PROXY=2
DATABASE_SSL=false
DATABASE_SSL_CA=
FRONTEND_URL=https://sdh.example.edu.vn
API_PUBLIC_URL=https://sdh.example.edu.vn/api
REACT_APP_API_URL=/api
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only used when explicitly running the initial administrator seed.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
HOST=
HOSTPORT=587
SERVICE=
EMAIL_USERNAME=
PASSWORD=
